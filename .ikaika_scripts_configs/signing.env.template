# Copy to signing.env and fill in; signing.env is gitignored - never commit real values.
# The SAME file in both portal repos, ikaika_portal_backend and ikaika_portal_frontend_rewrite,
# like debug.env and release.env: one team secret, so a signing.env made for one is the
# signing.env for the other. Only the portal signs anything today - Android, Windows and Linux,
# release and debug - and the API reads none of it until it has something to sign.
#
# Passwords never go anywhere else: not into a form, a remembered answer or a command line.
# certificates (.\script.ps1 certificates) reads them to check, make and convert the keys,
# and a CI run gets them from <env.prefix>_KS_*, _WIN_* and _LINUX_* variables instead.

# Android. Both keystores - android.keystorePath (release) and android.debugKeystorePath
# (debug) in ikaika_scripts.env - open with keystore.storePassword; certificates -New makes
# them PKCS#12, which has one password, so keystore.keyPassword is that same value or blank.
# keystore.alias overrides android.keyAlias; the debug key's alias is it plus -debug.
# keystore.path overrides android.keystorePath for this machine only - leave it blank.
keystore.storePassword=
keystore.keyPassword=
keystore.alias=
keystore.path=

# Windows. Both code-signing certificates - windows.certPath (release) and
# windows.debugCertPath (debug) - open with win.certPassword; the subject they are issued to is
# windows.publisher in ikaika_scripts.env. win.certPath and win.debugCertPath override those
# paths for this machine only - leave them blank.
win.certPassword=
win.certPath=
win.debugCertPath=

# Linux. Both GPG signing keys - linux.signingKeyPath (release) and linux.debugSigningKeyPath
# (debug) - are locked with linux.keyPassphrase.
linux.keyPassphrase=
