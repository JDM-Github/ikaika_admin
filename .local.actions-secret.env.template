# The Build release workflow's secrets, for .\script.ps1 ci-local when GitHub Actions is down.
# Copy this file to .local.actions-secret.env beside it - git ignores that name - and fill in the values
# GitHub keeps for this repo under Settings > Secrets and variables > Actions. Never commit the copy.
# TOOLKIT_BITBUCKET_* are not needed here: this checkout already has the toolkit.

# Reads Bitbucket's tags and pushes the version commit and tag; needs Repositories: Write.
BITBUCKET_REPO_TOKEN=
# Only when the token is an app password rather than a repository access token.
BITBUCKET_REPO_USER=
# Pushes the version to GitHub and publishes the release; optional, GitHub is best effort.
GH_MIRROR_TOKEN=
# The shared folder link holding the sealed secrets archive, and its password.
SHARED_FILES_URL=
SHARED_FILES_PASSWORD=
