APP_NAME="IKAIKA Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_CHANNEL=development
# Subdirectory in front of /api. Empty locally. Bluehost example: /staging/central-api
API_PATH_PREFIX=
# Vite/CSS public URLs. Empty locally. On Bluehost set this OR leave it empty and API_PATH_PREFIX is used.
# laravel-vite-plugin reads ASSET_URL at `npm run build` — no VITE_ copy is required.
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ikaika_platform
DB_USERNAME=root
DB_PASSWORD=

PORTAL_ENABLED=true
PORTAL_DB_DATABASE=test_portal_database
PORTAL_DB_USERNAME=root
PORTAL_DB_PASSWORD=
PORTAL_IPWHOIS_URL=https://ipwho.is
PORTAL_IP_GEOLOCATION_URL=https://ipapi.co
PORTAL_IP_LOOKUP_PRIVATE=true

CORE_DB_DATABASE=ikaika_platform

ESTIMATOR_ENABLED=false
ESTIMATOR_DB_DATABASE=test_estimator_database

PORTAL_JWT_SECRET=
PORTAL_JWT_TTL=28800

# Azure AD SPA app for portal Microsoft sign-in. Same IDs as msal_test. Public client IDs, not secrets.
PORTAL_AZURE_TENANT_ID=70c0daac-fc8d-46de-b3eb-db0ce575ae83
PORTAL_AZURE_CLIENT_ID=f995e827-5f8b-49ee-8cd5-b05b99017558
PORTAL_AZURE_REDIRECT_URI=http://localhost:8081
# Optional. Set this only if the Azure app is a Web (confidential) client.
# PORTAL_AZURE_CLIENT_SECRET=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
