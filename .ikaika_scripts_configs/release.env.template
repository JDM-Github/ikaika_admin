# Copy to release.env and fill in; release.env is gitignored - never commit real values.
# The SAME file in both portal repos, ikaika_portal_backend and ikaika_portal_frontend_rewrite:
# the API and the portal deploy with one login, so a release.env made for one is the
# release.env for the other. server/deploy-release reads it, checked against release.env.sha256
# beside it; CI gets it from the sealed archive (secrets -Seal).
#
# PRODUCTION - for now the same Bluehost account as debug.env, with the portal at v2/ at the
# site root rather than in the Test Server's website_a85fbf18 folder. The Build release plan
# refuses production until the release.* keys in ikaika_scripts.env name it too.

# The account's SSH login. The private key lives at ~/.ssh/<ssh.keyName>, never in this repo;
# SSHPASSPHRASE unlocks it, and certificates -New ssh makes a new key with it.
Hostname=eox.vhu.mybluehost.me
SSHUsername=
SSHPASSPHRASE=

# Home-relative work folder both repos' server scripts use: upload/, scripts/, backups/ and the
# API's app/.
DIR=apps/test-server

# Home-relative folders each end is served from on production - the deployment paths, handed
# to the server scripts by deploy.exports: API_PATH to deploy-admin.sh, PORTAL_PATH to
# deploy-portal.sh.
# The folder production's domain serves as its root: a deployment path's URL is the part after it.
SITE_ROOT=public_html
API_PATH=public_html/website_a85fbf18/central-api
PORTAL_PATH=public_html/v2
