# The project identity file for ikaika_portal_backend, read by the ikaika_scripts
# toolkit vendored at decoupled-script/. Scaffolded from that submodule's
# ikaika_scripts.env.template, which is where every comment below comes from - keep
# the comments when filling a key in, they are the documentation.
#
# NOTHING IS WIRED UP YET. The toolkit is here, the terminal app can reach it, and
# the command listing shows the toolkit's own git/ and toolkit/ domains. This
# project's build, test and deploy commands are deliberately absent until we know
# what a machine actually needs installed to run them; checks.<n> is likewise empty,
# so check-all currently gates on nothing. Both are the next thing to fill in.
#
# THIS FILE IS COMMITTED AND MAY NEVER HOLD A SECRET. That is the one rule here.
# Everything below is a name, a path, a URL or a version - facts about the project
# that every machine and CI needs and that none of them should have to be told twice.
#
# .gitignore ignores *.env wholesale, precisely because every other one
# (signing.env, jira.env, bitbucket.env) holds credentials. ikaika_scripts.env is
# un-ignored by an explicit exception, so the blanket rule still protects the
# rest. Do not put a password here just because the file happens to be writable:
# credentials belong in .ikaika_scripts_configs/, which stays ignored.
#
# Same KEY=VALUE format as those files, parsed by the same Read-EnvFile in
# decoupled-script/lib/load-env.ps1. Only the first '=' splits, values are never
# unquoted or expanded, and blank means "not set - use the toolkit's own default".

# ==========================[ Toolkit version ]================================
# The ikaika_scripts version this project USES - a pin, not a minimum.
#
# This is the readable half of the version: the submodule pointer records the same
# thing, but a gitlink is forty hex characters nobody reads in review, whereas a change
# here shows up in a diff as "0.5.0 -> 0.6.0".
#
# Edit it by hand and the next command notices the mismatch and offers to check the
# submodule out to match. Or do both in one step:
#   .\script.ps1 use-version 0.6.2
#   .\script.ps1 use-version -Latest
# Either way, commit this file and the submodule pointer together.
#
# Blank means "not managed": whatever is checked out runs, and nothing syncs.
scripts.version=1.36.1
# What to do when a newer tag exists on the toolkit's remote, and also what to do when
# the checkout does not match scripts.version above (one knob, not two):
#   ask    - show the options and choose: update now, not now, skip this version,
#            show what changed, or stop asking. Falls back to notify whenever stdin
#            is redirected or the host is non-interactive, so an unattended run
#            never sits waiting for a keypress.
#   auto   - fetch and check it out, unless the toolkit has uncommitted changes
#   notify - print the tag and the command, change nothing
#   off    - never touch the network. THE DEFAULT, so no command pays for a network
#            round trip it did not ask for. Note this also switches off the pin
#            sync, so a checkout that disagrees with scripts.version above is no
#            longer reconciled on its own - use-version is how you fix that. Set
#            notify to keep the sync and lose only the prompt.
# Ignored entirely until the toolkit is a real submodule with a remote; while it is
# a plain folder in the repo there is nothing to pull. <PREFIX>_SCRIPTS_NO_UPDATE=1
# in the environment overrides this - set that in CI, where tooling must be the
# pinned commit and nothing else.
scripts.updateMode=

# Whether a command run with NO arguments is fronted by a GUI built from its own
# parameters. Blank or 'auto' means yes; 'off' means never.
#
# The gate matters more than the switch: the form appears ONLY when no arguments were
# given, so every scripted call, hook and CI step runs untouched, and any failure to
# build a window at all falls through to the command line. For one run without
# changing this file, set <env.prefix>_SCRIPTS_NO_GUI=1.
#
# A command that opens its OWN dialog is left alone - it is detected, not listed.
scripts.gui=

# Whether a command NAMED with no arguments opens that form first, or just runs.
# Blank or 'auto' means it opens; 'off' means it runs.
#
# Narrower than scripts.gui on purpose, and the two are separate decisions.
# scripts.gui=off is the automation guard: nothing takes the screen on this machine, the
# terminal app included. This key leaves the front end alone - a bare .\script.ps1 still
# opens the terminal app - and changes only a DIRECT `.\script.ps1 <command>`, which runs
# with the command's own defaults instead of asking first.
#
# -I or -Interactive opens the form for one command anyway, and a command picked from the
# desktop launcher still gets one. For one run the other way, set
# <env.prefix>_SCRIPTS_NO_FORMS=1.
#
# Off suits a project whose front end is the terminal app: that app has a form of its own
# for every command, so the WPF one is a second answer to the same question.
scripts.forms=off
# How to start the terminal app, which is the front end a bare .\script.ps1 opens
# (ADR 0015). Written as a command line - "dti", "uv run dti",
# "python -m company_tui". Blank falls back to tui.root, then to whatever is on
# PATH: `dti` first, then `company`.
tui.command=
# A checkout of the terminal app to run it out of, for developing it beside the
# project it drives. Its .venv is preferred over anything on PATH: the venv is where
# the package IS, and a global python that cannot import it would otherwise win and
# fail with a module error instead of running.
#
# With neither key set, the app is simply absent and .\script.ps1 opens the desktop
# window instead. Nothing is ever installed automatically.
tui.root=C:\Users\Jonas\Projects\Personal\GitHub(jnsbnmndz)\ikaika_tui
# Where the terminal app is installed FROM when it is missing or too old, as
# owner/name on the host. BLANK TURNS INSTALLING OFF: nothing is fetched, and a
# machine without the app falls back to the window exactly as it did before.
tui.repository=jnsbnmndz/ikaika_tui
# Which copy runs when the machine has more than one: release (default) / debug /
# newest / checkout. Kind decides before version does - ordering by version alone put
# a debug build ahead of the release one the moment a newer debug existed, which is
# every moment between two releases. checkout means tui.root's working copy.
# <PREFIX>_SCRIPTS_TUI_PREFER overrides it for one machine or one session, since
# preferring a checkout is a personal habit and this file is committed.
tui.prefer=release
# The minimum version the project's integration needs - not the newest that
# exists. A floor above what the release channel can deliver offers an install on
# every run that the install can never satisfy. Blank accepts any version.
tui.version=0.1.1
# What to do when the app is absent or below that floor: ask / auto / notify / off.
# ask offers it and falls back to the window if declined; auto installs without
# asking; notify only says so. Defaults to ask, degrades to notify when there is no
# terminal to ask at, and <PREFIX>_SCRIPTS_NO_UPDATE turns it off outright.
tui.updateMode=ask
# true to accept a prerelease. Blank means official releases only - a debug build
# is published as a prerelease, which is what keeps it out of everyone's way.
tui.prereleases=
# Which asset of a release is the installer, as a glob. Blank means *-setup*.exe.
tui.assetPattern=
# The API root, for a host that is not github.com. Blank means api.github.com.
tui.apiBase=
# Hours between remote checks. The check runs ahead of every command, so this stops
# a build waiting on the network to start. 0 checks every single run.
scripts.updateCheckHours=
# Whether to check that this machine has what setup-dev-env installs - the pre-push
# hook and the modules check-all needs - and offer to fix what is missing:
#   ask    - list what is missing and offer to install it. The default.
#   notify - one line naming what is missing, change nothing
#   off    - never check
# Nothing forces anyone to run setup, and nothing otherwise notices if a hook is
# deleted or a module vanishes with a PowerShell reinstall. A gate that silently
# stops existing is worse than no gate, because everyone still believes it is there.
#
# Never triggered by setup-dev-env, check-all or bump-version, and silenced by
# <PREFIX>_SCRIPTS_NO_PROMPT or <PREFIX>_SCRIPTS_NO_UPDATE - the pre-push hook and CI
# set those.
scripts.readinessMode=
# Hours between readiness checks, when there is nothing to report. An OUTSTANDING issue
# is raised on the next command rather than waiting this out - "not now" is how you ask
# for quiet, and that is what this throttles.
scripts.readinessCheckHours=

# Which command DOMAINS the listing and the picker show, numbered rather than
# delimited so adding one is a line. Blank shows every domain, which is what a
# consumer that never sets this keeps getting.
#
# Visibility only. Every command still RUNS whether or not its domain is listed,
# and a bare name still resolves across all of them, so this cannot break a
# command or a consumer's own commands/ override. Hidden domains are reported
# with a count rather than silently dropped, for the same reason check-all prints
# SKIP: a listing that quietly omits things looks like a toolkit that lacks them.
#
# A consumer's OWN commands/ block and its .ikaika_scripts_configs/domains/
# folders are always shown and never need naming here.
#
# A name that matches no domain is reported and ignored.
#
#   scripts.domains.1=git
#   scripts.domains.2=toolkit
scripts.domains.1=git
scripts.domains.2=toolkit
scripts.domains.3=server
scripts.domains.4=signing

# ===========================[ Pre-push checks ]===============================
# Commands run by .\script.ps1 check-all, in numeric order, from the repo root. Any
# non-zero exit fails the run. Numbered rather than delimited so adding one is a line
# and the order is explicit; checks.10 correctly follows checks.9.
#
# Declared per project because the toolkit is meant to grow past Flutter - "flutter
# analyze" means nothing in a .NET consumer. The toolkit's own Pester and
# PSScriptAnalyzer checks run regardless and need no keys here.
#
# Install as a git pre-push hook with: .\script.ps1 check-all -InstallHook
#
#   checks.1=flutter analyze --fatal-infos --fatal-warnings
#   checks.2=flutter test --coverage
#   checks.3=bash decoupled-script/flutter/check-coverage.sh
# FAST ENOUGH FOR EVERY PUSH. composer.json is the one file whose breakage stops
# everybody rather than just the person who broke it, and validating it costs under a
# second.
checks.1=composer validate --strict --no-check-publish
checks.2=pwsh -NoProfile -File .ikaika_scripts_configs/commands/ci-check.ps1
# Anything too slow to want on every push. Run with: check-all -Full
#   checks.slow.1=flutter build web --release
#
# The suite: 328 tests, a little over two minutes. Too slow to want on every push,
# which is exactly what checks.slow is for - it runs on check-all -Full and in CI.
checks.slow.1=php artisan test

# Whether check-all runs the toolkit's own Pester and PSScriptAnalyzer over the
# vendored submodule. on, or off (the default).
#
# These are the TOOLKIT's gate, not this project's. A consumer that never edits
# decoupled-script/ is paying for them on every push of application code and getting
# nothing back - so switching them off is a reasonable choice, not a corner cut. Whoever
# does edit the toolkit runs them with -ToolkitOnly, which overrides this key precisely
# because that flag is a request for exactly these checks.
#
# Skipped checks are reported as SKIP, never omitted, so a run cannot look like it
# verified something it did not.
checks.toolkit=

# NOT WIRED IN, and the reason is worth recording so nobody adds it and reverts it.
# `vendorin\pint --test` fails on the tree as it stands - six files, mostly the two
# legacy root ones (routes - portal-ikaikabim.php, services - portal_airtable.php). A
# gate that is red the day it is added teaches everyone to pass --no-verify, so it stays
# out until somebody runs `vendorin\pint` once and commits the reformatting. Then:
#   checks.2=vendorin\pint --test

# How much of the above a PUSH runs. Only ever grades the pre-push hook - running
# check-all by hand always runs everything, because typing it is an explicit request
# for the checks and a gate that quietly ran half of them would report a pass it did
# not earn.
#   full - every check. What a project with a real gate should set.
#   fast - skip the checks.<n> numbers named by hooks.fastSkip below. For a suite
#          that is correct to run but too slow to sit through on every push; the
#          skipped ones are listed as SKIP, never dropped silently.
#   off  - run nothing and let the push through. THE DEFAULT: a gate is a choice a
#          project makes on purpose, not one the toolkit makes for it. Read on every
#          run, so this also neutralises an already-installed hook, and setup-dev-env
#          stops installing one - there is nothing to uninstall.
#
# This file is COMMITTED, so a value here is a decision for the whole team - turning
# the gate off in it turns it off for everyone, in a commit. To change it for yourself
# only, put the same key in .ikaika_scripts_configs/local.env: gitignored by the same
# bare *.env rule that covers signing.env, and it overrides this file key by key.
#
# Bypassing one single push needs none of this: git push --no-verify.
hooks.prePush=
# Which checks.<n> numbers hooks.prePush=fast skips, comma or space separated. Numbers
# rather than command text, so a check does not silently start running again the day
# somebody edits a flag onto it.
#   hooks.fastSkip=2,3
hooks.fastSkip=

# ==========================[ Repository workflow ]============================
# Branch pull-updates takes updates FROM when -Branch is not given. This is the
# shared integration branch, not the branch you work on: a feature branch pulls from
# it so that its own merge back is a fast-forward rather than a pile of conflicts
# found at review time.
#
# Blank means 'development'. Set it when the project integrates somewhere else -
# main, master, develop, release/next - so nobody has to pass -Branch every time.
#   git.updateBranch=main
git.updateBranch=

# run-at-tag checks a tag out into a detached worktree OUTSIDE this repository, copies
# today's toolkit in over the tag's own, runs a command there and copies the results
# back. Your branch, working tree and index are never touched.
#
# Command to run when -Command is not given. Blank means check-all - a read-only
# verification, which is the safe thing to do to an old version by default. Set it to
# build-release in a project where "run at a tag" usually means rebuilding it.
#   tagbuild.command=build-release
tagbuild.command=

# Folder whose files are copied back out of the worktree, relative to the repo root,
# recursively and keeping their shape. Blank copies nothing but the transcript.
#   tagbuild.artifactDir=dist
tagbuild.artifactDir=

# A COMMITTED file that proves the checkout populated - pubspec.yaml, composer.json, a
# .sln. Blank asks git for the worktree's HEAD instead, which needs no stack knowledge
# and is the right answer when older tags predate whatever file you would name here.
#   tagbuild.marker=composer.json
tagbuild.marker=

# Build inputs git does NOT track, and which a fresh worktree therefore does not have:
# signing keys, local property files, wrapper jars. Copied in from the current checkout,
# numbered so adding one is a line, and missing ones are skipped silently.
#
# .ikaika_scripts_configs and .env are always staged - every stack needs them - so these
# are only for what is true because of YOUR stack.
#   tagbuild.stage.1=android/key.properties
#   tagbuild.stage.2=android/keystore
tagbuild.stage.1=
tagbuild.stage.2=

# =============================[ Project identity ]============================
# Artifact filename stem: dist/<prefix>-<version>[-debug]-<platform>.<ext>. Also
# the pattern the dist retention sweep matches, so changing it orphans older
# artifacts rather than pruning them.
artifact.prefix=
# Human-readable name, used in installer labels and window titles.
app.displayName=Ikaika Portal
# One line saying what this project is. Read into the emitted ikaika.script.json,
# where the terminal app shows it. Defaults to "Commands for <name>".
app.description=The Laravel API behind the Ikaika portal
# The file holding this project's version, relative to the repo root - one line,
# x.y.z+n. Read into the emitted manifest so the app reports the PRODUCT's version
# rather than the toolkit's. Blank means 0.0.0+1; a stack whose version lives in a
# manifest it already has (pubspec.yaml, package.json) leaves this empty.
app.versionFile=
# The built executable's name, which is the Flutter project's own name: used bare
# for the Linux bundle and with .exe on Windows.
app.binaryName=
# Android application id. A debug build installs as this plus '.debug'.
android.appId=
# Prefix for the in-memory CI environment overrides: <PREFIX>_DEPLOY_*,
# <PREFIX>_KS_*, <PREFIX>_WIN_*. Nothing is written to disk under these.
env.prefix=IP

# ==========================[ .NET application ]===============================
# Read by dotnet/build-app.ps1. Blank dotnet.project means this consumer ships no
# .NET application and the domain is simply unused.

# The csproj to build, relative to the repo root.
dotnet.project=

# Where the payload is staged, relative to the repo root. Emptied on every build,
# so it must not be a directory holding anything else.
dotnet.stageDir=releases/test

# The executable the build is expected to produce, checked so a renamed
# AssemblyName fails loudly instead of producing a payload with no app in it.
# Blank uses app.binaryName with .exe appended.
dotnet.exeName=

# ------------------------------[ Bundled web UI ]-----------------------------
# A web front end staged beside the executable. Blank ui.dir means there is none
# and the step is skipped rather than failed.
ui.dir=
ui.buildScript=build
ui.distDir=dist
# Folder name beside the exe. Whatever loads the UI at run time has to agree with
# this, so it is configuration rather than a constant.
ui.stageName=ui

# ===========================[ Deploy targets ]================================
# --base-href each web build is compiled with. Must start and end with '/'.
release.baseHref=
debug.baseHref=
# The API base the app is built against, injected as the dart-define named by
# dart.define.apiBase below. FOLLOWS -Debug, like the manifest URLs: a debug build
# gets api.base, a release build api.baseProduction. Leave api.baseProduction blank
# only while production does not exist yet - a release build then falls back to
# whatever the app compiled in, and says so.
api.base=
api.baseProduction=
# Where an installed desktop/Android build looks for updates, injected as the
# dart-define named by dart.define.updateManifest. This one DOES follow -Debug: a
# staging build must never offer to replace itself with a production release, or the
# other way round.
release.updateManifestUrl=
debug.updateManifestUrl=

# Where the app fetches its own release notes, published as changelog.json at the site
# root by every release build. Follows -Debug like the two URLs above, so a staging build
# shows staging's notes rather than production's.
#
# The WEB app needs neither key - it fetches changelog.json relative to itself. These are
# for the native builds, which have no site to be relative to. Leave them blank and the
# native builds simply show no release notes.
release.changelogUrl=
debug.changelogUrl=
# The dart-define SYMBOLS the values above are injected under - they are names in
# your Dart source (String.fromEnvironment), so they belong to the app, not to this
# toolkit. Blank keeps the historical names PE_API_BASE, PE_UPDATE_MANIFEST and
# PE_CHANGELOG, which is what an existing consumer already reads; set them when your
# Dart uses different ones. Overriding a value per build with -DartDefine is matched against these names.
dart.define.apiBase=
dart.define.updateManifest=
dart.define.changelog=

# =============================[ Signing ]=====================================
# Android. The keystore itself is fetched into this path and verified against
# .ikaika_scripts_configs/<name>.sha256; it is never stored in the repo.
android.keystorePath=
android.keyAlias=
# Certificate CN used when generating a keystore from scratch.
android.commonName=
# Windows code signing. Two certificates, one per build mode, so test builds
# never touch the trust built up for the real release signature. Both are fetched
# into these paths and hash-verified the same way.
windows.certPath=
windows.debugCertPath=
# Must match the certificate subject exactly, or signtool fails.
windows.publisher=

# ==========================[ Shared-folder sources ]==========================
# Where setup and the build fetch credential and signing files from, each
# hash-verified on arrival against its committed sidecar. Links, not secrets -
# they are access-controlled on the sharing side.
# ONE folder link that serves all of them. A folder share downloads as a zip, and the
# entry whose NAME matches the file being fetched is the one taken - so a single link can
# carry the keystore, both certificates and the deploy config, each still verified
# against its own committed checksum.
#
# Prefer this. A link per file means re-sharing and re-pasting every time one is rotated,
# and a folder link stays valid while its contents are replaced.
#   share.folder=https://<tenant>-my.sharepoint.com/:f:/g/personal/<user>/<id>
share.folder=

# Per-file links, which WIN over share.folder where set. Only needed when a file must
# come from somewhere else - a debug certificate handed out without giving access to the
# folder the release one is in, say.
share.deployConfig=
share.keystore=
share.cert=
share.debugCert=
# certificates -Collect gathers what is ready for the shared folder here; gitignored.
share.uploadDir=share-upload

# =============================[ SSH deploy ]==================================
# Private key filename under ~/.ssh/, and the stem for its committed
# <name>.sha256 and <name>.known_hosts anchors in .ikaika_scripts_configs/. The
# key itself never lives in the repo.
ssh.keyName=project_estimator

# First commands to show under "Getting started" in the command list. The toolkit has
# no idea what a good first command is for YOUR stack - it used to hardcode Flutter's,
# so a PHP repo was told to build an app it does not have. Format: command|note.
#   help.start.1=deploy-backend -Debug|deploy to staging
#   help.start.2=build-backend|package a release
help.start.1=development-setup|prepare this machine, then this repo
help.start.2=development-setup -Report|say what is missing, change nothing
help.start.3=environment-variables|re-point PATH after a WampServer version switch

# ==========================[ PHP backend deploy ]=============================
# Read by php/deploy-backend.ps1. Ignore this whole section in a project that
# does not ship PHP.
#
# The files to upload, relative to the repo root, one numbered key each. Numbered
# rather than delimited so adding one is a line, and so a filename containing a
# comma or a space needs no escaping.
#   php.source.1=routes - my_app.php
#   php.source.2=services - my_app.php
php.source.1=
php.source.2=

# What each file is called ON THE SERVER, when that differs from the repo. Blank
# means "same name", which is the normal case - set it only if the two disagree.
#
# This matters more than it looks. The plugin's include statement names each file
# explicitly, so a file uploaded under the wrong name is simply never required:
# the upload succeeds, the hash verifies, the deploy reports success, and the
# server keeps running the old code. There is no error anywhere to notice. If a
# deploy "works" but nothing changes, check this first.
#
# A bare file name, not a path - the directory comes from DIR. Two sources may not
# claim the same remote name.
#   php.source.1=routes - my_app.php
#   php.remoteName.1=routes - my-app.php
php.remoteName.1=
php.remoteName.2=

# ---------------------------[ Environment rewrite ]---------------------------
# WHY THIS EXISTS. A WordPress plugin `require_once`s every route file on every
# request, so a staging copy and a production copy of the same file end up in ONE
# PHP process, and a single database. PHP namespaces functions and classes, so
# those are safe once the namespace differs. NOTHING ELSE IS:
#   - file-scope $vars are truly global
#   - get_option()/transient keys are one shared database
#   - a MySQL advisory lock name is one shared server
# Whichever file loads second silently wins for all of them, and both environments
# then run on one environment's configuration. These rules rewrite the identifiers
# that carry environment identity, in a temporary staged copy, so the files in the
# repository are never touched.
#
# Rules are grouped by profile. 'staging' is applied by -Debug; 'production' is
# normally left blank, which means "upload exactly what is committed".
#
# EVERY RULE MUST MATCH SOMETHING, or the deploy is refused. A rule that quietly
# stops applying - because the PHP was renamed underneath it - is how staging ends
# up reading and writing production's data, and that failure is invisible until it
# has already happened.
#
# Values are 'from=>to'. Only the first '=' splits the KEY from the value, so the
# value may contain as many as it likes.

# Prepended to every file-scope global the engine finds. It derives that list from
# the file itself rather than from config, so a global added later is covered
# automatically.
#   php.staging.globalPrefix=stg_
php.staging.globalPrefix=
# Appended to the deployed filename, before the extension. Two copies in one plugin
# directory need two names.
#   php.staging.fileSuffix=_staging
php.staging.fileSuffix=
# Namespace paths, replaced wherever they appear - the declaration, `use` imports,
# and fully-qualified references. A path that is merely a PREFIX of another is not
# matched, so parent and child namespaces can both be listed safely.
#   php.staging.namespace.1=vendor\routes\myApp=>vendor\routes\myAppStaging
#   php.staging.namespace.2=vendor\services\myApp=>vendor\services\myAppStaging
php.staging.namespace.1=
php.staging.namespace.2=
# Single-quoted literals matched in FULL. Use these for the values that become a
# route, an option name or a wp-config constant. Applied before literalPrefix, so a
# literal that also starts with a rewritten prefix gets this specific rule instead.
#   php.staging.literal.1=my_app=>my_app_staging
#   php.staging.literal.2=/my_app/=>/my_app_staging/
#   php.staging.literal.3=MYAPP_SESSION_KEY=>MYAPP_STAGING_SESSION_KEY
php.staging.literal.1=
php.staging.literal.2=
php.staging.literal.3=
# Single-quoted literals STARTING with the given text - one rule covers every
# option key, transient prefix and lock name sharing a house prefix.
#   php.staging.literalPrefix.1=ma_=>stg_ma_
php.staging.literalPrefix.1=

# ==========================[ React Native (android) ]=========================
# Read by the react-native/ commands only. Every one has a working default, so a
# React Native project laid out the standard way needs none of these set - they
# exist for a project that moved something, not as required configuration.
#
# Deliberately NOT here: the app version, the keystore and its passwords. The
# version lives in package.json, which is React Native's own source of truth, and
# the upload key lives in android/gradle.properties or ~/.gradle/gradle.properties
# where React Native documents it and where Gradle already reads it. Copying
# either into this file would create a second place for one fact to be wrong, and
# this file must never hold a secret.

# The android directory, relative to the repo root. Default: android
rn.android.dir=
# Gradle module holding the app, used to build :<module>:assembleRelease.
# Default: app
rn.gradle.module=
# package.json path, relative to the repo root. Default: package.json
rn.manifest=

# =====================[ Developer environment baseline ]======================
# What "a correctly set up machine" means for this project, so "it works on mine"
# becomes a checkable claim. setup-dev-env.ps1 verifies against these and reports
# PASS/WARN/FAIL per line; nothing here is read at build time.
#
# Deliberately NOT here: the Dart SDK constraint. pubspec.yaml's environment.sdk
# already states it and is what actually gates a build, so repeating it would
# leave two places to disagree. Setup reads it from there.

# Flutter channel every machine should track.
flutter.channel=
# Lowest acceptable Flutter version, so one machine on a year-old SDK is visible
# rather than mysterious. Blank accepts any.
flutter.minVersion=
# Major JDK version setup installs (Temurin) if none is found. Blank defaults to 17.
jdk.version=17
# Platforms this team builds. A tool needed only by a platform nobody here builds
# is reported as optional rather than missing.
platforms=
# WSL distribution that builds Linux; blank uses WSL's own default.
linux.distro=
# Whether shell scripts must be LF. A switch rather than an assumption because
# .gitattributes enforces it and setup verifies the two agree.
lineEndings.requireLfForShell=
# Tools checked but never installed automatically - each is big, slow, or needs
# its own licence prompts. Values are the check's severity:
#   required - FAIL when missing
#   platform - FAIL only when its platform is in `platforms` above
#   optional - WARN when missing
tool.flutter=
tool.git=
tool.jdk=
tool.androidsdk=
tool.nsis=
tool.vsbuildtools=
tool.wsl=
tool.powershell7=required
# The two PowerShell modules check-all needs. Setup offers to install both from
# PSGallery into CurrentUser scope; check-all reports SKIP rather than FAIL when one
# is absent, so a project that does not want them can grade them out entirely.
tool.pester=
tool.psscriptanalyzer=



# ==========================[ How the listing is grouped ]======================
# Optional. How a front end may GATHER the domains for browsing - a flat list of a
# dozen is a list nobody reads.
#
# A LISTING ORDER, NOT A HIERARCHY. `jira/issues` stays `jira/issues`; what a command
# is called and where it is typed does not move. Grouping by renaming would turn
# `acc/files` into `autodesk/acc-files`, making every path longer to serve a menu
# nobody is looking at while they type.
#
#   group.<n>=<Heading>: <domain>, <domain>, ...
#
# Numbered because a menu has an order. Only the first colon splits, so a heading may
# contain one. A domain named in no group stays where it is, top level and ungrouped -
# which is what makes this safe to adopt one line at a time, and what makes a typo in a
# domain name cost nothing worse than a heading with one fewer entry.
#
# Absent entirely - as it is here - and the manifest carries no `groups` key at all.

# ======================[ Development Setup - this project ]===================
# Read by .ikaika_scripts_configs/commands/development-setup.ps1. Not in the
# toolkit's template: these are this repository's machine requirements, and the
# toolkit has no business knowing them. They live here rather than in the script so
# that moving to a newer PHP is a line in a config file and not a code edit.

# Where WampServer is, or is installed to when it is absent. NOT under Program
# Files: WampServer refuses a path with spaces, and Apache's own configuration
# stores this path in a dozen places that are rewritten on every version change.
setup.wampRoot=C:\wamp64
# The PHP and MySQL SERIES this project runs now live in dev.json, beside every other
# declared version, so there is one place to read "what does this need" and one line to
# change when it moves. They were here first; the keys are gone rather than kept as
# aliases, because two sources for one version is how they end up disagreeing.

# Where the add-on installers come from, and which ones. WampServer 3.4.0 bundles
# PHP 8.4.15 already, so the PHP add-on is normally a no-op; it bundles MySQL 8.4.7
# rather than an 8.0, so the MySQL one normally is not.
#
# Pinned by exact filename on purpose. aviatechno publishes one installer per patch
# release and removes nothing, so a name that works today works in a year - whereas
# "the newest 8.0" would have every machine on a different one. Bump these two lines
# when the project moves, and every machine moves with it on its next run.
setup.addonBase=https://wampserver.aviatechno.net/files
setup.phpAddon=php/wampserver3_x64_addon_php8.4.25.exe
setup.mysqlAddon=mysql/wampserver3_x64_addon_mysql8.0.46.exe

# Where composer.phar and its .bat shim go. Blank means %LOCALAPPDATA%\Composer\bin,
# which is per user and needs no administrator - deliberately, because a Composer
# installed while elevated belongs to the administrator account and is invisible to
# everyone else on the machine.
setup.composerDir=

# Which database owns the name `mysql` on PATH. WampServer installs MySQL and MariaDB
# side by side and BOTH ship a mysql.exe, so whichever lands on PATH first is what
# `mysql` means for everyone on the machine. Named rather than guessed, because a
# developer connecting to MariaDB with a client that says MySQL on the tin is a bug
# report nobody can reproduce. mysql, or mariadb.
setup.dbFlavor=mysql

# COMPOSER_HOME - where Composer keeps its cache, auth.json and globally required
# packages. Blank means %APPDATA%\Composer, which is what Composer computes for itself
# when the variable is unset.
#
# Declared anyway, and the reason is worth the line: that default is worked out PER
# PROCESS from APPDATA, so a scheduled task, a service account or a shell started from
# another profile silently gets a different one - its own cache, its own credentials,
# its own global packages. An existing value is never overwritten.
setup.composerHome=

# ==========================[ Running the servers ]============================
# Read by .ikaika_scripts_configs/commands/run-servers.ps1.

# The port `php artisan serve` binds. Blank means 8000, which is what APP_URL in
# .env.example already points at - change both together or the app links to a port
# nothing is listening on.
#
# This is the DEFAULT, not a lock: run-servers -ApiPort takes a different one for a
# single run, and offers this value first in the list it draws.
serve.apiPort=
# The port Vite binds. Blank means 5173, Vite's own default.
serve.vitePort=
# Where phpMyAdmin lives on this Apache. Blank means http://localhost/phpmyadmin,
# which is where WampServer puts it.
serve.phpMyAdminUrl=
# How long to wait for a started server to answer on its port before saying so. Blank
# means 30 seconds. `php artisan serve` bootstraps the framework before it binds, and on
# a cold run that is several seconds - a shorter wait reports "slow" for a server that
# was about to be fine.
serve.startTimeoutSeconds=

# ==================[ Release deploy and the Build release workflow ]==================
# The Bitbucket repo GitHub mirrors; the Build release workflow syncs from it and pushes
# the version commit and tag back to it.
mirror.source=https://bitbucket.org/ikaika-web/ikaika_portal_backend.git

# server/deploy-release: the archive deployment/build.ps1 writes, the server scripts that go
# up with every deploy, and the one that installs the release - see deployment/README.md.
deploy.archive=deployment/out/central-platform.zip
deploy.scriptsDir=deployment/server
deploy.script=deploy-admin.sh

# Staging is the Bluehost Test Server site. deploy-admin.sh's ROOT is DIR in debug.env.
debug.serverEnv.1=SITE_DIR=website_a85fbf18
debug.serverEnv.2=SITE_URL=https://eox.vhu.mybluehost.me/website_a85fbf18
debug.serverEnv.3=API_CHANNEL=staging
debug.healthUrl=https://eox.vhu.mybluehost.me/website_a85fbf18/central-api/api/staging/portal/health
# Read by this repo's build-release: the public folder Vite bakes into the font URLs.
debug.assetUrl=/website_a85fbf18/central-api

# Production is not set up yet, and the Build release plan refuses it while
# release.assetUrl is blank. Fill these, and a release.env, when it is.
release.serverEnv.1=
release.healthUrl=
release.assetUrl=
