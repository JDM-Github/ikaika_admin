# Copy to debug.env and fill in; debug.env is gitignored - never commit real values.
# The SAME file in both portal repos, ikaika_portal_backend and ikaika_portal_frontend_rewrite:
# the API and the portal deploy to one Test Server account with one login, so a debug.env made
# for one is the debug.env for the other. server/deploy-release -Debug reads it, checked
# against debug.env.sha256 beside it; CI gets it from the sealed archive (secrets -Seal).
#
# STAGING - the Bluehost Test Server. Production is release.env, a file of its own, so a
# staging deploy can never reach the live site.

# The Bluehost account's SSH login. The private key lives at ~/.ssh/<ssh.keyName> - the
# project estimator's, the same account - never in this repo; SSHPASSPHRASE unlocks it,
# and certificates -New ssh makes a new key with it.
Hostname=eox.vhu.mybluehost.me
SSHUsername=
SSHPASSPHRASE=

# Home-relative work folder both repos' server scripts use: the upload/, scripts/ and
# backups/ of deploy-admin.sh (the API) and deploy-portal.sh (the portal), and the API's app/.
# Never the estimator's folder - a copy of its debug.env names that one.
DIR=apps/test-server

# Home-relative folders each end is served from - the deployment paths. deploy.exports in each
# repo's ikaika_scripts.env hands its own to its server script: API_PATH to deploy-admin.sh,
# PORTAL_PATH to deploy-portal.sh, which swaps a build for another base href in beside it.
# The folder test.ikaikabim.com serves as its root: a deployment path's URL is the part after it, so
# public_html/website_a85fbf18/portal is https://test.ikaikabim.com/portal.
SITE_ROOT=public_html/website_a85fbf18
API_PATH=public_html/website_a85fbf18/central-api
PORTAL_PATH=public_html/website_a85fbf18/portal

# The address Microsoft sign-in returns to, exactly as the Azure app registers it (Single-page application).
# The portal's build bakes it in and the API only redeems a sign-in issued for it, so both ends read this one line.
AZURE_REDIRECT_URI=https://test.ikaikabim.com/portal
