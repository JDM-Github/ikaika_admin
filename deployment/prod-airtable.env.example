# Copy this to C:\IKAIKA\ikaika_admin\.env.production (gitignored) and fill in the production values.
# Do not point push-prod-airtable.ps1 at the repo's local .env.
APP_ENV=production
AIRTABLE_ENV=prod
AIRTABLE_TOKEN=<production PAT: data.records:read, data.records:write, schema.bases:read on all four PROD bases>
# Main base: the _PROD key is the one AIRTABLE_ENV=prod reads.
AIRTABLE_BASE_ID_PROD=app8jGTzRDQt4yPIa
# Leave these empty for the first Users & Projects send; add a base when enabling it.
AIRTABLE_CALENDAR_PROD=
AIRTABLE_CLIENT_INFORMATION_PROD=
# Tracker sync is intentionally off (2026-10-22, supervisor); leave this empty until approved.
AIRTABLE_TRANSACTION_TRACKER_PROD=
# false until the first manual --send is checked; then true.
AIRTABLE_SYNC_SCHEDULED=false
