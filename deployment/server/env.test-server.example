# Server .env for the Bluehost Test Server. Lives at /home2/eoxvhumy/apps/test-server/.env
# deploy-admin.sh copies it into every release. Fill REPLACE_ values from the staging server .env, never from chat or Git.

APP_NAME="IKAIKA Platform"
APP_ENV=staging
APP_KEY=base64:REPLACE_WITH_EXISTING_SERVER_APP_KEY
APP_DEBUG=false
APP_URL=https://test.ikaikabim.com/central-api

API_CHANNEL=staging
# Empty on Bluehost: Apache strips the subfolder before Laravel sees the path.
API_PATH_PREFIX=
ASSET_URL=/central-api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DB_* / PORTAL_DB_* / TRACKER_DB_* below are overridden by test-server/db.env (create-databases.sh).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=eoxvhumy_ikaika_platform
DB_USERNAME=eoxvhumy_JDM
DB_PASSWORD="REPLACE_WITH_CENTRAL_DATABASE_PASSWORD"
CORE_DB_DATABASE=eoxvhumy_ikaika_platform

PORTAL_ENABLED=true
PORTAL_DB_DATABASE=eoxvhumy_test_portal
PORTAL_DB_USERNAME=eoxvhumy_JDM
PORTAL_DB_PASSWORD="REPLACE_WITH_PORTAL_DATABASE_PASSWORD"

ESTIMATOR_ENABLED=false
ESTIMATOR_DB_DATABASE=eoxvhumy_estimator

# Finance / Budget Tracker database. Leave false until it exists on the server.
TRACKER_ENABLED=false
TRACKER_DB_DATABASE=REPLACE_WITH_TRACKER_DATABASE

PORTAL_JWT_SECRET=REPLACE_WITH_EXISTING_JWT_SECRET
PORTAL_JWT_TTL=28800
PORTAL_IP_LOOKUP_PRIVATE=false

# Microsoft sign-in. The redirect must equal the portal URL and be registered in Azure (SPA).
PORTAL_AZURE_TENANT_ID=70c0daac-fc8d-46de-b3eb-db0ce575ae83
PORTAL_AZURE_CLIENT_ID=f995e827-5f8b-49ee-8cd5-b05b99017558
PORTAL_AZURE_REDIRECT_URI=https://test.ikaikabim.com/portal

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/central-api
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mail. log = written to storage/logs only. On this host sendmail works with no mailbox (see email-delivery notes).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ikaikabim.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=ikaikabim.com
# Only for MAIL_MAILER=wprelay (the WordPress bridge on ikaikabim.com).
MAIL_RELAY_URL=https://ikaikabim.com/wp-json/ikaika-portal/v1/mail
MAIL_RELAY_KEY=REPLACE_WITH_RELAY_KEY

# Email images upload here.
CLOUDINARY_CLOUD_NAME=REPLACE
CLOUDINARY_API_KEY=REPLACE
CLOUDINARY_API_SECRET=REPLACE

# Airtable sync (Developer mode).
AIRTABLE_TOKEN=REPLACE
AIRTABLE_BASE_ID=REPLACE
