# Copy to release.env and fill in; release.env is gitignored - never commit real values.
# The SAME file in both portal repos, ikaika_portal_backend and ikaika_portal_frontend_rewrite:
# the API and the portal deploy to one production folder with one login, so a release.env
# made for one is the release.env for the other. server/deploy-release reads it, checked
# against release.env.sha256 beside it; CI gets it from the sealed archive (secrets -Seal).
#
# PRODUCTION - not set up yet; the Build release plan refuses it until ikaika_scripts.env
# names one. Staging is debug.env, a file of its own, so the two never mix.

# The production account's SSH login. The private key lives at ~/.ssh/<ssh.keyName>, never
# in this repo; SSHPASSPHRASE unlocks it, and certificates -New ssh makes a new key with it.
Hostname=
SSHUsername=
SSHPASSPHRASE=

# Home-relative folder both repos' server scripts work in on production: the upload/,
# scripts/ and backups/ of deploy-admin.sh (the API) and deploy-portal.sh (the portal) -
# never the Test Server's apps/test-server.
DIR=
