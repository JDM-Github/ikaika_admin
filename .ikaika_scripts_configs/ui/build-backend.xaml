<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build release"
        SizeToContent="Height" Width="720" MaxHeight="900"
        ResizeMode="CanResize" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

  <!-- MARKUP ONLY - every handler is in build-backend.ps1 beside this file.
       Project-owned: this describes THIS repo's release, so it lives in
       .ikaika_scripts_configs/ and not in the replaceable submodule. -->

  <Border Style="{StaticResource WindowRoot}">
    <DockPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="CopyLogButton" Style="{StaticResource QuietButton}" Content="Copy log" Visibility="Collapsed" />
        <Button x:Name="BackButton" Style="{StaticResource QuietButton}" Content="Back to menu" Visibility="Collapsed" />
        <Button x:Name="CancelButton" Style="{StaticResource QuietButton}" Content="Cancel" IsCancel="True" />
        <Button x:Name="BuildButton" Style="{StaticResource PrimaryButton}" Content="Build" IsDefault="True" />
      </StackPanel>

      <!-- Docked, so the heading cannot scroll away. It used to sit INSIDE the one
           scroller below along with everything else, so a running build pushed the
           project name and version off the top of the window. -->
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Style="{StaticResource H1}" Text="Build release" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Subtle}" Text="" Margin="0,0,0,14" />
      </StackPanel>

      <!-- Options and console in ONE grid, not one scroller.
           Auto for the options, so a short form reserves no space it does not use, with
           MaxHeight to stop a tall one pushing the console out. Star for the console, so it
           takes whatever is left instead of running past the bottom of the window - measured
           before this, the stdin row landed at y=1308 in a 900px window, which is why Send
           and the input box could not be reached at all during a run. -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

      <!-- Everything the user chooses. Collapsed once a run starts, so the console
           gets the whole window instead of being squeezed under a form nobody can
           act on any more. -->
      <StackPanel x:Name="OptionsPanel">

        <!-- Build from: first, because a tag carries its own version, and so decides whether the
             version choices below apply at all. A tag is rebuilt for staging only (2026-10-21). -->
        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Build from" Margin="0,0,0,8" />
            <ComboBox x:Name="FromCombo" />
            <TextBlock x:Name="FromNote" Style="{StaticResource Subtle}" Text="" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- Version. The numbers beside each choice come from the toolkit's shared
             Get-VersionChoices, so this repo bumps by the same rules as every other. -->
        <Border x:Name="VersionCard" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Version" Margin="0,0,0,8" />
            <WrapPanel>
              <RadioButton x:Name="VerSameRadio"  GroupName="Ver" IsChecked="True" Margin="0,0,14,0" Content="same" />
              <RadioButton x:Name="VerKeepRadio"  GroupName="Ver" Margin="0,0,14,0" Content="keep" />
              <RadioButton x:Name="VerPatchRadio" GroupName="Ver" Margin="0,0,14,0" Content="patch" />
              <RadioButton x:Name="VerMinorRadio" GroupName="Ver" Margin="0,0,14,0" Content="minor" />
              <RadioButton x:Name="VerMajorRadio" GroupName="Ver" Margin="0,0,14,0" Content="major" />
              <RadioButton x:Name="VerCustomRadio" GroupName="Ver" Margin="0,0,8,0" Content="custom" />
              <TextBox x:Name="VerCustomBox" Width="96" Padding="6,3" IsEnabled="False"
                       VerticalContentAlignment="Center" />
            </WrapPanel>
            <TextBlock x:Name="VersionHintText" Style="{StaticResource Subtle}" Text="" Margin="0,8,0,0" />
            <CheckBox x:Name="TagCheck" IsEnabled="False" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Body}" Text="Commit, tag and push this version" />
                <TextBlock Style="{StaticResource Subtle}"
                           Text="Once the build is good, tag-version files the changelog under this version, commits VERSION and tags it on Bitbucket - the tag is how anyone else checks this release out. Unticked, only VERSION is written locally." />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Target" Margin="0,0,0,8" />
            <RadioButton x:Name="ProductionRadio" GroupName="Target" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Style="{StaticResource Body}" Text="Production" />
                <TextBlock Style="{StaticResource Subtle}" Text="release.assetUrl and release.env. Refused while production is not set up." />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="StagingRadio" GroupName="Target" IsChecked="True">
              <StackPanel>
                <TextBlock Style="{StaticResource Body}" Text="Staging" />
                <TextBlock Style="{StaticResource Subtle}"
                           Text="The Bluehost Test Server: debug.assetUrl and debug.env." />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="After packaging" Margin="0,0,0,8" />
            <CheckBox x:Name="DeployCheck" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Style="{StaticResource Body}" Text="Upload to the server" />
                <TextBlock x:Name="DeployHintText" Style="{StaticResource Subtle}" Text="" />
              </StackPanel>
            </CheckBox>
            <CheckBox x:Name="DryRunCheck" Margin="18,0,0,6" IsEnabled="False">
              <TextBlock Style="{StaticResource Body}" Text="Dry run - name what would go up and run, upload nothing" />
            </CheckBox>
            <CheckBox x:Name="CleanCheck" Margin="18,0,0,0" IsEnabled="False">
              <TextBlock Style="{StaticResource Body}" Text="Remove older backups and a failed deploy's leftovers on the server" />
            </CheckBox>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Style="{StaticResource Body}" Text="Keep" VerticalAlignment="Center" />
              <TextBox x:Name="KeepBox" Text="10" Width="52" Margin="10,0,10,0" Padding="6,4"
                       VerticalContentAlignment="Center" />
              <TextBlock Style="{StaticResource Subtle}" Text="archives in dist/, older ones pruned"
                         VerticalAlignment="Center" />
            </StackPanel>
            <!-- OFF by default, which is what flutter/build-release does: the dialog
                 picks, the terminal runs. That path is the proven one - real console,
                 real colours, real prompts, nothing between the script and the user. -->
            <CheckBox x:Name="RunHereCheck" IsChecked="False">
              <StackPanel>
                <TextBlock Style="{StaticResource Body}" Text="Run in this window instead of the terminal" />
                <TextBlock Style="{StaticResource Subtle}"
                           Text="Off: the dialog closes and the run appears in the terminal you launched from. On: output is captured into a panel here." />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <!-- What Build runs, as it would be typed: anything picked here once can be typed next time. -->
        <TextBlock x:Name="WillRunText" Style="{StaticResource Subtle}" FontFamily="{StaticResource MonoFont}"
                   Text="" TextWrapping="Wrap" Margin="2,10,0,0" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource Body}" Foreground="{StaticResource Danger}"
                   Text="" Margin="2,10,0,0" />
      </StackPanel>

      </ScrollViewer>

      <!-- The console. Collapsed until a run starts. -->
      <Border Grid.Row="1" x:Name="ConsolePanel" Visibility="Collapsed"
              Style="{StaticResource CardPanel}" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Grid.Row on ALL THREE, and it is load-bearing. Without it every child defaults
               to row 0 and they are laid on top of each other: measured, the status text and
               the output box both rendered 621x589 at the same point, and Send became an
               88x589 button whose label floats halfway down the console. It reads as text
               "spilling" out of the box rather than as three controls in one cell. -->
          <TextBlock x:Name="ConsoleStatusText" Grid.Row="0" Style="{StaticResource Body}"
                     FontWeight="SemiBold" Text="Running..." TextWrapping="Wrap" Margin="0,0,0,8" />

          <TextBox x:Name="ConsoleOutput" Grid.Row="1" Style="{StaticResource MonoBox}"
                   MinHeight="260" AcceptsReturn="True"
                   HorizontalScrollBarVisibility="Auto" />

          <!-- stdin. The child process gets whatever is typed here, so a Read-Host or
               a y/n confirmation can be answered without a separate terminal. -->
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ConsoleInput" Padding="8,6"
                     VerticalContentAlignment="Center" IsEnabled="False" />
            <Button Grid.Column="1" x:Name="SendButton" Style="{StaticResource QuietButton}"
                    Content="Send" IsEnabled="False" />
          </Grid>
        </Grid>
      </Border>

      </Grid>

    </DockPanel>
  </Border>
</Window>

