APP_NAME="IKAIKA Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_CHANNEL=development
# Subdirectory in front of /api. Empty locally. Bluehost example: /staging/central-api
API_PATH_PREFIX=
# Vite/CSS public URLs. Empty locally. On Bluehost set this OR leave it empty and API_PATH_PREFIX is used.
# laravel-vite-plugin reads ASSET_URL at `npm run build` — no VITE_ copy is required.
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ikaika_platform
DB_USERNAME=root
DB_PASSWORD=

PORTAL_ENABLED=true
PORTAL_DB_DATABASE=test_portal_database
PORTAL_DB_USERNAME=root
PORTAL_DB_PASSWORD=
# Where the web app answers, for server-built links (a shared page's link and QR). Empty locally;
# the hosted build sets the subfolder base, e.g. https://host/website_x/portal
PORTAL_PUBLIC_URL=
# Send mapped inbox notices as emails too. Set false on a machine that must not email real inboxes.
PORTAL_NOTIFICATION_EMAILS=true
PORTAL_IPWHOIS_URL=https://ipwho.is
PORTAL_IP_GEOLOCATION_URL=https://ipapi.co
PORTAL_IP_LOOKUP_PRIVATE=true

CORE_DB_DATABASE=ikaika_platform

ESTIMATOR_ENABLED=false
ESTIMATOR_DB_DATABASE=test_estimator_database

TRACKER_ENABLED=true
TRACKER_DB_DATABASE=test_tracker_database

PORTAL_JWT_SECRET=
PORTAL_JWT_TTL=28800

# Azure AD SPA app for portal Microsoft sign-in. Same IDs as msal_test. Public client IDs, not secrets.
PORTAL_AZURE_TENANT_ID=70c0daac-fc8d-46de-b3eb-db0ce575ae83
PORTAL_AZURE_CLIENT_ID=f995e827-5f8b-49ee-8cd5-b05b99017558
PORTAL_AZURE_REDIRECT_URI=http://localhost:8081
# Optional. Set this only if the Azure app is a Web (confidential) client.
# PORTAL_AZURE_CLIENT_SECRET=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Airtable portal sync: a token scoped to the TEST base only.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Read-only Bitbucket access token for MIS projects' code activity (portal:bitbucket-sync).
BITBUCKET_TOKEN=
# The secret set on each repository's push webhook (POST /api/<channel>/bitbucket/webhook).
BITBUCKET_WEBHOOK_SECRET=

# Jira Cloud for Issues & Requests: a service account (not a Jira admin) with Browse projects, Create
# issues, Create attachments, Edit issues, Transition issues, Link issues and Assign issues on the project, and Browse users
# and groups on the site, which finds each MIS member's account by their work address (2026-10-22). Production and the Test Server share one
# project (2026-10-21): each labels and follows only its own issues - staging's carry a staging label, a PC's a development
# one. Leave any of the first four empty and nothing is sent to Jira.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Only for a scoped API token, which works only through Atlassian's gateway: the site's cloudId (from
# https://<site>.atlassian.net/_edge/tenant_info; portal:jira-check prints it). Empty for a classic token.
JIRA_CLOUD_ID=
# The secret on the admin webhook a Jira admin registers (php artisan portal:jira-check prints it all).
JIRA_WEBHOOK_SECRET=
# The issue type each kind is filed as; a project without one falls back to Task.
# JIRA_ISSUE_TYPE_BUG=Bug
# JIRA_ISSUE_TYPE_FEATURE=Story
# JIRA_ISSUE_TYPE_FEEDBACK=Task
# A report's plan is the issue's too (2026-10-22): the team every new issue goes to, by name (blank, none), and the
# site's Team and Start date fields, which portal:jira-check finds by their type and name; set them only if it cannot.
# JIRA_DEFAULT_TEAM=DEV
# JIRA_FIELD_TEAM=customfield_10001
# JIRA_FIELD_START_DATE=customfield_10015

# The 18:00 missing-report reminder sends on production alone (2026-10-22): every other server runs on a copy of
# production's reports. true or false here says otherwise. A day on which fewer than this share of people filed is
# taken for one the records lack, and nobody is reminded of it.
# REPORT_REMINDERS_SCHEDULED=
# REPORT_REMINDERS_MIN_FILED_SHARE=0.5

# The password a deployed portal asks with an ID-number sign-in; only MIS holds it. Unset, ID sign-in is refused.
PORTAL_ID_LOGIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AIRTABLE_TOKEN=REDACTED_AIRTABLE_PAT
AIRTABLE_BASE_ID=app8DvnFZErPZT5Az
